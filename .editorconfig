root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.cs]
indent_size = 4

# xUnit1051 (thread TestContext.Current.CancellationToken through every async
# call) is pre-existing across every test in tests/**, predates this change,
# and TreatWarningsAsErrors turns it into a hard build failure. Downgraded
# here, scoped to test files only, so `dotnet test` can actually run instead
# of failing to build. Not a runtime-behavior change; this file only exists
# to fix a repo-wide test-project build break, not to relax analyzers on the
# product code in src/.
[tests/**/*.cs]
dotnet_diagnostic.xUnit1051.severity = suggestion

[*.md]
trim_trailing_whitespace = false
